{
  "name": "quantico-ai-os",
  "version": "0.1.0",
  "description": "Quantico AI OS V0.1 multimodel orchestration skeleton.",
  "type": "module",
  "private": true,
  "bin": {
    "quantico": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "smoke:anthropic": "npm run build && node --env-file-if-exists=.env dist/src/manual/anthropic-smoke.js",
    "smoke:openai": "npm run build && node --env-file-if-exists=.env dist/src/manual/openai-smoke.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/*.js\""
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
